{
  "providers": {
    "tokenharbor": {
      "label": "Token Harbor",
      "base_url": "https://tokenharbor.ai/v1",
      "chat_endpoint": "/chat/completions",
      "models_endpoint": "/models",
      "api_style": "openai-compatible",
      "key_url": "https://tokenharbor.ai/dashboard",
      "enabled": true,
      "models": {
        "qwen": {
          "id": "qwen3.8-flash:free",
          "label": "Qwen 3.8 Flash",
          "enabled": true,
          "default": true,
          "modalities": ["text", "image", "video"],
          "use_for": ["general_text", "image_understanding", "video_understanding"]
        },
        "deepseek": {
          "id": "deepseek-v4.1-flash:free",
          "label": "DeepSeek V4.1 Flash",
          "enabled": true,
          "modalities": ["text", "image"],
          "use_for": ["general_text", "code", "image_understanding"]
        },
        "mimo": {
          "id": "mimo-v2.6-flash:free",
          "label": "MiMo v2.6 Flash",
          "enabled": true,
          "modalities": ["text"],
          "use_for": ["general_text"]
        }
      }
    },

    "groq": {
      "label": "Groq",
      "base_url": "https://api.groq.com/openai/v1",
      "chat_endpoint": "/chat/completions",
      "models_endpoint": "/models",
      "api_style": "openai-compatible",
      "key_url": "https://console.groq.com/keys",
      "docs_url": "https://console.groq.com/docs/models",
      "enabled": true,
      "note": "Very fast LPU inference with a free tier.",
      "models": {
        "gpt_oss_120b": {
          "id": "openai/gpt-oss-120b",
          "label": "GPT-OSS 120B",
          "enabled": true,
          "default": true,
          "modalities": ["text"],
          "use_for": ["general_text", "reasoning", "code"],
          "context": 131072
        },
        "gpt_oss_20b": {
          "id": "openai/gpt-oss-20b",
          "label": "GPT-OSS 20B",
          "enabled": true,
          "modalities": ["text"],
          "use_for": ["general_text", "fast_drafts"],
          "context": 131072
        },
        "llama_33_70b": {
          "id": "llama-3.3-70b-versatile",
          "label": "Llama 3.3 70B",
          "enabled": true,
          "modalities": ["text"],
          "use_for": ["general_text", "code"],
          "context": 131072
        },
        "llama_31_8b": {
          "id": "llama-3.1-8b-instant",
          "label": "Llama 3.1 8B Instant",
          "enabled": true,
          "modalities": ["text"],
          "use_for": ["general_text", "fast_drafts"],
          "context": 131072
        },
        "qwen3_27b": {
          "id": "qwen/qwen3.8-27b",
          "label": "Qwen 3.8 27B",
          "enabled": true,
          "modalities": ["text"],
          "use_for": ["general_text", "reasoning"],
          "context": 131072
        },
        "minimax_m27": {
          "id": "minimaxai/minimax-m2.7",
          "label": "MiniMax M2.7",
          "enabled": true,
          "modalities": ["text"],
          "use_for": ["general_text", "long_context"],
          "context": 196608
        }
      }
    },

    "openrouter": {
      "label": "OpenRouter",
      "base_url": "https://openrouter.ai/api/v1",
      "chat_endpoint": "/chat/completions",
      "models_endpoint": "/models",
      "api_style": "openai-compatible",
      "key_url": "https://openrouter.ai/keys",
      "docs_url": "https://openrouter.ai/docs",
      "enabled": true,
      "note": "Aggregator: hundreds of models behind one key. IDs ending in :free cost nothing.",
      "headers": {
        "HTTP-Referer": "https://github.com/Jeeva-zone/chat_bot",
        "X-Title": "Token Harbor AI Team Studio"
      },
      "models": {
        "qwen3_27b_free": {
          "id": "qwen/qwen3.8-27b:free",
          "label": "Qwen 3.8 27B (free)",
          "enabled": true,
          "default": true,
          "modalities": ["text"],
          "use_for": ["general_text", "reasoning"]
        },
        "nemotron_super_free": {
          "id": "nvidia/nemotron-3-super-120b-a12b:free",
          "label": "Nemotron 3 Super 120B (free)",
          "enabled": true,
          "modalities": ["text"],
          "use_for": ["general_text", "reasoning"]
        },
        "gemma4_31b_free": {
          "id": "google/gemma-4-31b-it:free",
          "label": "Gemma 4 31B (free)",
          "enabled": true,
          "modalities": ["text"],
          "use_for": ["general_text"]
        },
        "deepseek_v41": {
          "id": "deepseek/deepseek-v4.1-flash",
          "label": "DeepSeek V4.1 Flash",
          "enabled": true,
          "modalities": ["text"],
          "use_for": ["general_text", "code"]
        },
        "gpt6_luna": {
          "id": "openai/gpt-6-luna",
          "label": "GPT-6 Luna",
          "enabled": true,
          "modalities": ["text"],
          "use_for": ["general_text", "code", "reasoning"]
        },
        "claude_opus_55": {
          "id": "anthropic/claude-opus-5.5",
          "label": "Claude Opus 5.5",
          "enabled": true,
          "modalities": ["text"],
          "use_for": ["general_text", "code", "long_context"]
        },
        "grok_47": {
          "id": "x-ai/grok-4.7",
          "label": "Grok 4.7",
          "enabled": true,
          "modalities": ["text"],
          "use_for": ["general_text", "reasoning"]
        }
      }
    },

    "gemini": {
      "label": "Google Gemini",
      "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
      "chat_endpoint": "/chat/completions",
      "models_endpoint": "/models",
      "api_style": "openai-compatible",
      "key_url": "https://aistudio.google.com/apikey",
      "docs_url": "https://ai.google.dev/gemini-api/docs/openai",
      "enabled": true,
      "note": "A Google AI Studio key works against the OpenAI-compatible endpoint.",
      "models": {
        "gemini_38_flash": {
          "id": "gemini-3.8-flash",
          "label": "Gemini 3.8 Flash",
          "enabled": true,
          "default": true,
          "modalities": ["text", "image"],
          "use_for": ["general_text", "image_understanding", "fast_drafts"]
        },
        "gemini_31_pro": {
          "id": "gemini-3.1-pro",
          "label": "Gemini 3.1 Pro",
          "enabled": true,
          "modalities": ["text", "image"],
          "use_for": ["general_text", "reasoning", "code"]
        },
        "gemini_31_flash_lite": {
          "id": "gemini-3.1-flash-lite",
          "label": "Gemini 3.1 Flash Lite",
          "enabled": true,
          "modalities": ["text"],
          "use_for": ["general_text", "fast_drafts"]
        },
        "gemini_3_flash": {
          "id": "gemini-3-flash",
          "label": "Gemini 3 Flash",
          "enabled": true,
          "modalities": ["text", "image"],
          "use_for": ["general_text", "image_understanding"]
        },
        "gemini_25_pro": {
          "id": "gemini-2.5-pro",
          "label": "Gemini 2.5 Pro",
          "enabled": true,
          "modalities": ["text", "image"],
          "use_for": ["general_text", "reasoning", "long_context"]
        }
      }
    },

    "custom": {
      "label": "Custom provider",
      "base_url": "",
      "chat_endpoint": "/chat/completions",
      "models_endpoint": "/models",
      "api_style": "openai-compatible",
      "enabled": true,
      "custom": true,
      "note": "Point this at any OpenAI-compatible server: LM Studio, Ollama, vLLM, a gateway or your own proxy. Set the base URL and model IDs in Settings.",
      "models": {}
    }
  },

  "routing": {
    "text": ["tokenharbor", "groq", "openrouter", "gemini", "custom"]
  },

  "defaults": {
    "provider": "tokenharbor",
    "text": "tokenharbor"
  }
}
